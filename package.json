{
  "name": "@doitintl/doit-mcp-server",
  "version": "2.1.0",
  "description": "DoiT official MCP Server",
  "keywords": [
    "doit",
    "mcp",
    "mcp-server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doitintl/doit-mcp-server.git"
  },
  "homepage": "https://github.com/doitintl/doit-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/doitintl/doit-mcp-server/issues"
  },
  "author": "",
  "type": "module",
  "bin": {
    "doit-mcp-server": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "tsc",
    "build": "tsc && shx cp src/tools/generated/openapi.json dist/tools/generated/openapi.json && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src/ test/",
    "lint:fix": "biome lint --write src/ test/",
    "format": "biome format src/ test/",
    "format:fix": "biome format --write src/ test/",
    "check:dev": "yarn type-check && biome check src/ test/",
    "check:ci": "yarn type-check && biome ci src/ test/",
    "check:fix": "biome check --write src/ test/",
    "generate:refresh-spec": "node scripts/refresh-generated-spec.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "dotenv": "^17.4.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@readme/openapi-parser": "^9.0.0",
    "@types/node": "^22",
    "openapi-types": "^12.1.3",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "volta": {
    "node": "22.21.1",
    "yarn": "1.22.22"
  }
}
